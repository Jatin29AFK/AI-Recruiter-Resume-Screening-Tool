{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "_info": {
    "title": "Send Resume to AI Screening",
    "description": "Power Automate Flow — forwards resume attachments from a shared mailbox or a recruiter's button press to the AI Resume Matcher ingest webhook. No Microsoft Graph API used; runs entirely on standard Outlook + HTTP connectors.",
    "version": "1.0.0",
    "usage": "IMPORTANT: Power Automate 'Import (Legacy)' expects a ZIP package exported from Power Automate, not a raw JSON file. Use this file as a build blueprint (copy steps) to create the Flow manually."
  },
  "parameters": {
    "INGEST_WEBHOOK_URL": {
      "description": "Full URL of your backend ingest endpoint",
      "example": "https://your-backend.com/ingest/upload-base64",
      "required": true
    },
    "INGEST_SECRET": {
      "description": "The value of INGEST_SECRET set in your backend .env",
      "required": true,
      "sensitive": true
    },
    "SHARED_MAILBOX": {
      "description": "Email address of the shared mailbox to monitor  (e.g. resumes@yourcompany.com)",
      "required": true
    }
  },
  "flows": {
    "auto_trigger": {
      "title": "Auto — new email with attachment in shared mailbox",
      "trigger": {
        "type": "outlook_shared_mailbox",
        "event": "When a new email arrives in a shared mailbox (V2)",
        "settings": {
          "mailboxAddress": "@{parameters('SHARED_MAILBOX')}",
          "folderPath": "Inbox",
          "onlyWithAttachments": true,
          "includeAttachments": true
        }
      },
      "condition": {
        "description": "Only process messages that have at least one PDF or DOCX attachment",
        "expression": "contains(triggerBody()?['hasAttachments'], true)"
      },
      "actions": [
        {
          "step": 1,
          "name": "Apply to each attachment",
          "type": "Apply_to_each",
          "input": "@triggerBody()?['attachments']",
          "inner_actions": [
            {
              "step": "1a",
              "name": "Check file type",
              "type": "Condition",
              "expression": "or(endsWith(toLower(items('Apply_to_each')?['name']), '.pdf'), endsWith(toLower(items('Apply_to_each')?['name']), '.docx'))",
              "if_true": [
                {
                  "step": "1b",
                  "name": "POST to ingest webhook (JSON base64)",
                  "type": "HTTP",
                  "method": "POST",
                  "uri": "@{parameters('INGEST_WEBHOOK_URL')}",
                  "headers": {
                    "X-Ingest-Secret": "@{parameters('INGEST_SECRET')}"
                  },
                  "body_type": "application/json",
                  "fields": {
                    "filename": "@{items('Apply_to_each')?['name']}",
                    "content_base64": "@{items('Apply_to_each')?['contentBytes']}",
                    "recruiter_email": "@{triggerBody()?['from']?['emailAddress']?['address']}",
                    "message_id": "@{triggerBody()?['internetMessageId']}",
                    "subject": "@{triggerBody()?['subject']}"
                  }
                },
                {
                  "step": "1c",
                  "name": "Check response",
                  "type": "Condition",
                  "expression": "equals(outputs('POST_to_ingest_webhook_(JSON_base64)')?['statusCode'], 200)",
                  "if_false": [
                    {
                      "step": "1c-fail",
                      "name": "Log failure (optional)",
                      "type": "Compose",
                      "inputs": "Ingest failed for @{items('Apply_to_each')?['name']}. Status: @{outputs('POST_to_ingest_webhook_(JSON_base64)')?['statusCode']}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "manual_button": {
      "title": "Manual — recruiter clicks 'Send to Screening' button for a selected email",
      "trigger": {
        "type": "outlook_action_button",
        "event": "For a selected message (V2)",
        "description": "Recruiter selects an email in Outlook and clicks the Flow button. Prompts for optional Job ID."
      },
      "inputs": [
        {
          "name": "job_description_or_id",
          "type": "text",
          "label": "Job Description or Job ID (optional)",
          "description": "Paste the JD text or enter the saved Job ID. Leave blank to save the resume without scoring."
        }
      ],
      "actions": [
        {
          "step": 1,
          "name": "Get email details",
          "type": "outlook_get_email",
          "message_id": "@triggerBody()?['entity']?['ItemId']"
        },
        {
          "step": 2,
          "name": "Apply to each attachment",
          "type": "Apply_to_each",
          "input": "@body('Get_email_details')?['attachments']",
          "inner_actions": [
            {
              "step": "2a",
              "name": "Check file type",
              "type": "Condition",
              "expression": "or(endsWith(toLower(items('Apply_to_each')?['name']), '.pdf'), endsWith(toLower(items('Apply_to_each')?['name']), '.docx'))",
              "if_true": [
                {
                  "step": "2b",
                  "name": "POST to ingest webhook (JSON base64)",
                  "type": "HTTP",
                  "method": "POST",
                  "uri": "@{parameters('INGEST_WEBHOOK_URL')}",
                  "headers": {
                    "X-Ingest-Secret": "@{parameters('INGEST_SECRET')}"
                  },
                  "body_type": "application/json",
                  "fields": {
                    "filename": "@{items('Apply_to_each')?['name']}",
                    "content_base64": "@{items('Apply_to_each')?['contentBytes']}",
                    "recruiter_email": "@{body('Get_email_details')?['from']?['emailAddress']?['address']}",
                    "message_id": "@{body('Get_email_details')?['internetMessageId']}",
                    "subject": "@{body('Get_email_details')?['subject']}",
                    "job_description": "@{triggerBody()?['text']['job_description_or_id']}"
                  }
                }
              ]
            }
          ]
        },
        {
          "step": 3,
          "name": "Notify recruiter",
          "type": "outlook_send_email",
          "to": "@{body('Get_email_details')?['from']?['emailAddress']?['address']}",
          "subject": "Resume submitted for screening",
          "body": "The resume(s) from this email have been submitted to the AI Screening tool. You will see results in the Screening Dashboard shortly."
        }
      ]
    }
  },
  "setup_instructions": [
    "Power Automate cannot import this JSON directly (it expects a ZIP export).",
    "Create a new Cloud Flow manually using the steps described in this file.",
    "Use INGEST_WEBHOOK_URL pointing to /ingest/upload-base64 (JSON) — easier than multipart.",
    "Header required: X-Ingest-Secret = INGEST_SECRET.",
    "Trigger: 'When a new email arrives in a shared mailbox (V2)' OR 'For a selected message (V2)'.",
    "Action: HTTP → POST JSON body with filename + content_base64 + metadata fields."
  ]
}
