# API Configuration
APP_NAME=AI Resume Job Matcher API
APP_VERSION=1.0.0

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Intake — REQUIRED for /ingest/* endpoints
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SECRET=change-this-to-a-long-random-string

# Email Intake — Optional IMAP auto-polling
# If not set, use Power Automate webhook or manual upload only
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_USER=resumes@yourcompany.com
# IMAP_PASSWORD=service-account-password
# IMAP_MAILBOX=INBOX
# IMAP_POLL_INTERVAL=120

# Email Intake — DEMO SETUP with Gmail (see DEMO_SETUP_GUIDE.md)
# Uncomment and replace with your demo Gmail account:
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your-company-resumes@gmail.com
# IMAP_PASSWORD=your-16-char-app-password-here
# IMAP_MAILBOX=INBOX
# IMAP_POLL_INTERVAL=60
